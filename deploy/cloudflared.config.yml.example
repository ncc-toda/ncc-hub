# /etc/cloudflared/config.yml に配置する
# <TUNNEL_ID> は `cloudflared tunnel create works` の出力で置き換える
tunnel: <TUNNEL_ID>
credentials-file: /etc/cloudflared/<TUNNEL_ID>.json
ingress:
  - hostname: works.example.jp
    service: http://127.0.0.1:8090
    originRequest:
      noTLSVerify: true
  - service: http_status:404
